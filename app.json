{
  "expo": {
    "name": "SportTimer",
    "slug": "SportTimer",
    "owner": "ck",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "backgroundColor": "#ff4c4c",
    "primaryColor": "#ff4c4c",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": false,
      "hidden": false
    },
    "scheme": "sporttimer",
    "icon": "./assets/icons/clock.png",

    "userInterfaceStyle": "dark",
    "web": {
      "output": "static",
      "favicon": "./assets/icons/clock.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ff4c4c",
          "image": "./assets/icons/clock.png",
          "imageWidth": 76
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
